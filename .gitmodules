[submodule "Kans3D/vendor/spdlog"]
	path = Kans3D/vendor/spdlog
	url = https://github.com/gabime/spdlog
[submodule "Kans3D/vendor/glm"]
	path = Kans3D/vendor/glm
	url = https://github.com/g-truc/glm

[submodule "Kans3D/vendor/imgui"]
	path = Kans3D/vendor/imgui
	url = https://github.com/ocornut/imgui.git
[submodule "Kans3D/vendor/yaml-cpp"]
	path = Kans3D/vendor/yaml-cpp
	url = https://github.com/jbeder/yaml-cpp.git
[submodule "Kans3D/vendor/GLFW"]
	path = Kans3D/vendor/GLFW
	url = https://github.com/glfw/glfw.git
[submodule "test"]
	path = test
	url = https://github.com/kanzakishigure/Kans3D-tests.git
	branch = main
[submodule "Kans3D/vendor/harfbuzz"]
	path = Kans3D/vendor/harfbuzz
	url = https://github.com/harfbuzz/harfbuzz
	shallow = true
[submodule "Kans3D/vendor/msdfgen"]
	path = Kans3D/vendor/msdfgen
	url = https://github.com/Chlumsky/msdfgen
	shallow = true
[submodule "Kans3D/vendor/PhysX"]
	path = Kans3D/vendor/PhysX
	url = https://github.com/NVIDIA-Omniverse/PhysX.git
	shallow = true
