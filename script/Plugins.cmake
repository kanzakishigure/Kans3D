# Use the runtime parser at configure time, including under MSVC. No ABI/dynamic loading step.
set(KANS_PLUGIN_PROJECT "" CACHE FILEPATH "Project .kproj whose enabled C++ plugin modules are compiled")
set(_kans_plugin_tool "${CMAKE_BINARY_DIR}/plugin-configure")
set(_kans_plugin_generated "${CMAKE_BINARY_DIR}/plugins")
set(_kans_plugin_compiler_args "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}")
if(CMAKE_GENERATOR_PLATFORM)
    list(APPEND _kans_plugin_compiler_args -A "${CMAKE_GENERATOR_PLATFORM}")
endif()
if(CMAKE_GENERATOR_TOOLSET)
    list(APPEND _kans_plugin_compiler_args -T "${CMAKE_GENERATOR_TOOLSET}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${PROJECT_SOURCE_DIR}/script/PluginConfigure" -B "${_kans_plugin_tool}"
    -G "${CMAKE_GENERATOR}" "-DCMAKE_POLICY_VERSION_MINIMUM=3.5" ${_kans_plugin_compiler_args} "-DKANS_SOURCE_ROOT=${PROJECT_SOURCE_DIR}"
    RESULT_VARIABLE _kans_result OUTPUT_VARIABLE _kans_output ERROR_VARIABLE _kans_error)
if(NOT _kans_result EQUAL 0)
    message(FATAL_ERROR "Plugin parser configure failed: ${_kans_output}\n${_kans_error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${_kans_plugin_tool}" --config Release -j2
    RESULT_VARIABLE _kans_result OUTPUT_VARIABLE _kans_output ERROR_VARIABLE _kans_error)
if(NOT _kans_result EQUAL 0)
    message(FATAL_ERROR "Plugin parser build failed: ${_kans_output}\n${_kans_error}")
endif()
if(CMAKE_CONFIGURATION_TYPES)
    set(_kans_plugin_exe "${_kans_plugin_tool}/Release/KansPluginConfigure${CMAKE_EXECUTABLE_SUFFIX}")
else()
    set(_kans_plugin_exe "${_kans_plugin_tool}/KansPluginConfigure${CMAKE_EXECUTABLE_SUFFIX}")
endif()
execute_process(COMMAND "${_kans_plugin_exe}" "${PROJECT_SOURCE_DIR}/Plugins" "${KANS_PLUGIN_PROJECT}" "${_kans_plugin_generated}"
    RESULT_VARIABLE _kans_result OUTPUT_VARIABLE _kans_output ERROR_VARIABLE _kans_error)
if(NOT _kans_result EQUAL 0)
    message(FATAL_ERROR "Plugin discovery failed: ${_kans_output}\n${_kans_error}")
endif()
if(_kans_error)
    message(STATUS "${_kans_error}")
endif()
file(GLOB_RECURSE _kans_manifests CONFIGURE_DEPENDS
    "${PROJECT_SOURCE_DIR}/Plugins/*/kansplugin.yaml")
if(KANS_PLUGIN_PROJECT)
    get_filename_component(_kans_project_dir "${KANS_PLUGIN_PROJECT}" DIRECTORY)
    file(GLOB_RECURSE _kans_project_manifests CONFIGURE_DEPENDS "${_kans_project_dir}/Plugins/*/kansplugin.yaml")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KANS_PLUGIN_PROJECT}" ${_kans_project_manifests})
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_kans_manifests}
    "${PROJECT_SOURCE_DIR}/script/PluginConfigure/main.cpp"
    "${PROJECT_SOURCE_DIR}/Kans3D/src/Kans3D/Plugin/PluginManifest.cpp")
target_sources(Kans3D PRIVATE "${_kans_plugin_generated}/RuntimePlugins.cpp")
add_library(KansEditorPlugins STATIC "${_kans_plugin_generated}/EditorPlugins.cpp")
target_link_libraries(KansEditorPlugins PUBLIC KansEditorCore)
target_link_libraries(KansEditor PRIVATE KansEditorPlugins)
set_target_properties(KansEditorPlugins PROPERTIES FOLDER "Plugins")
include("${_kans_plugin_generated}/Plugins.cmake")
